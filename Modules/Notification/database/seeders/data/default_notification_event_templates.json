[
    {
        "event_slug": "create_cause",
        "name": {"en": "Create Cause Notification", "ar": "إشعار إنشاء قضية"},
        "is_reminder": false,
        "type": "notification",
        "templates": [
            {
                "channel": "notification",
                "title": {"en": "New Cause Created", "ar": "تم إنشاء قضية جديدة"},
                "body": {"en": "A new cause #{{cause_number}} has been created: {{subject}}", "ar": "تم إنشاء قضية جديدة رقم #{{cause_number}}: {{subject}}"}
            },
            {
                "channel": "email",
                "title": {"en": "New Cause Created", "ar": "تم إنشاء قضية جديدة"},
                "body": {"en": "Dear User,\nA new cause #{{cause_number}} has been created.\nSubject: {{subject}}\n\nPlease review it at your earliest convenience.", "ar": "عزيزي المستخدم،\nتم إنشاء قضية جديدة رقم #{{cause_number}}.\nالموضوع: {{subject}}\n\nيرجى مراجعتها في أقرب وقت ممكن."}
            },
            {
                "channel": "push",
                "title": {"en": "New Cause #{{cause_number}}", "ar": "قضية جديدة #{{cause_number}}"},
                "body": {"en": "A new cause has been created: {{subject}}", "ar": "تم إنشاء قضية جديدة: {{subject}}"}
            },
            {
                "channel": "sms",
                "title": {"en": "New Cause", "ar": "قضية جديدة"},
                "body": {"en": "New cause #{{cause_number}} created. Subject: {{subject}}", "ar": "تم إنشاء قضية جديدة رقم #{{cause_number}}. الموضوع: {{subject}}"}
            }
        ]
    },
    {
        "event_slug": "cause_session_reminder",
        "name": {"en": "Cause Session Reminder", "ar": "تذكير بالجلسة"},
        "is_reminder": true,
        "type": "reminder",
        "templates": [
            {
                "channel": "reminder",
                "title": {"en": "Upcoming Session for Cause #{{cause_number}}", "ar": "جلسة قادمة للقضية #{{cause_number}}"},
                "body": {"en": "You have an upcoming session for cause #{{cause_number}}.", "ar": "لديك جلسة قادمة للقضية #{{cause_number}}."},
                "date_column": "date"
            },
            {
                "channel": "calendar",
                "title": {"en": "Session: Cause #{{cause_number}}", "ar": "جلسة: القضية #{{cause_number}}"},
                "body": {"en": "Court session for cause #{{cause_number}}", "ar": "جلسة محكمة للقضية #{{cause_number}}"},
                "date_column": "date"
            },
            {
                "channel": "notification",
                "title": {"en": "Session Reminder: Cause #{{cause_number}}", "ar": "تذكير بالجلسة: القضية #{{cause_number}}"},
                "body": {"en": "Reminder: You have a session for cause #{{cause_number}}.", "ar": "تذكير: لديك جلسة للقضية #{{cause_number}}."}
            },
            {
                "channel": "email",
                "title": {"en": "Session Reminder: Cause #{{cause_number}}", "ar": "تذكير بالجلسة: القضية #{{cause_number}}"},
                "body": {"en": "Dear User,\nThis is a reminder about the upcoming session for cause #{{cause_number}}.\n\nPlease prepare accordingly.", "ar": "عزيزي المستخدم،\nهذا تذكير بالجلسة القادمة للقضية #{{cause_number}}.\n\nيرجى التحضير وفقاً لذلك."}
            }
        ],
        "reminder_settings": [
            {"offset_type": "before", "offset_unit": "day", "offset_value": 1, "reminder_based_on_column": "date", "channel": "reminder"},
            {"offset_type": "before", "offset_unit": "hour", "offset_value": 2, "reminder_based_on_column": "date", "channel": "reminder"}
        ]
    },
    {
        "event_slug": "update_cause_status",
        "name": {"en": "Cause Status Update", "ar": "تحديث حالة القضية"},
        "is_reminder": false,
        "type": "notification",
        "templates": [
            {
                "channel": "notification",
                "title": {"en": "Cause Status Updated", "ar": "تم تحديث حالة القضية"},
                "body": {"en": "The status of cause #{{cause_number}} has been updated.", "ar": "تم تحديث حالة القضية رقم #{{cause_number}}."}
            },
            {
                "channel": "email",
                "title": {"en": "Cause Status Updated", "ar": "تم تحديث حالة القضية"},
                "body": {"en": "Dear User,\nThe status of cause #{{cause_number}} has been updated.\n\nPlease review the changes.", "ar": "عزيزي المستخدم،\nتم تحديث حالة القضية رقم #{{cause_number}}.\n\nيرجى مراجعة التغييرات."}
            },
            {
                "channel": "push",
                "title": {"en": "Cause #{{cause_number}} Updated", "ar": "تحديث القضية #{{cause_number}}"},
                "body": {"en": "Cause status has been updated.", "ar": "تم تحديث حالة القضية."}
            }
        ]
    }
]

