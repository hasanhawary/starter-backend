{
    "name": "hasanhawary/ai-chat",
    "description": "Enterprise Laravel AI Chat Platform — MCP tools, project scanning, RAG, vector search, multi-agent, policy engine",
    "version": "0.1.0",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Hassan Elhawary"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "illuminate/auth": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/pipeline": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/prompts": "^0.1 || ^0.2 || ^0.3 || ^0.4"
    },
    "require-dev": {
        "laravel/ai": "^0.7.0",
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "laravel/ai": "Required for GLM/OpenAI provider integration, ChatAgent with Promptable trait, and conversation store (^0.7.0)",
        "laravel/framework": "Full Laravel framework — provides all illuminate/* packages at once (^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0)",
        "laravel/sanctum": "Required only if you use Sanctum-based authentication with the ResolveAiChatUser middleware (^3.0 || ^4.0)",
        "ext-pgsql": "Required for the PgVector driver (pgvector extension)"
    },
    "autoload": {
        "psr-4": {
            "AiChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiChat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AiChat\\AiChatServiceProvider"
            ],
            "aliases": {
                "AiChat": "AiChat\\Facades\\AiChat",
                "MCP": "AiChat\\Facades\\MCP"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
